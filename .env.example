# Copie para .env (e configure as mesmas variáveis no painel da hospedagem, ex.: Vercel/Netlify)

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Chave PÚBLICA VAPID do push web (a privada fica só na Edge Function send-push)
VITE_VAPID_PUBLIC_KEY=

# Endereço público do site (https, sem barra no fim). Usado em links de e-mail e compartilhamento.
VITE_APP_URL=https://apppani.app

# E-mail de suporte exibido no app, na política de privacidade e nas lojas
VITE_SUPORTE_EMAIL=suporte@apppani.app

# Nome da empresa/responsável (aparece na Política de Privacidade e nos Termos)
VITE_EMPRESA=AppPani

# Mostra o botão "Continuar com Apple" também na web/Android (no iPhone ele SEMPRE aparece — regra da App Store)
VITE_APPLE_LOGIN=false
